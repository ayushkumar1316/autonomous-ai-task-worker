# CentrAlign AI — Autonomous AI Task Worker
# Environment variables for LLM providers

# Groq (recommended — fast, free tier)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenRouter (optional alternative)
# Get key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1_your_openrouter_api_key_here

# Optional: override base URL for mock/testing
# GROQ_BASE_URL=http://127.0.0.1:8901/openai/v1

# Optional: specify model (defaults to provider's recommended)
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
